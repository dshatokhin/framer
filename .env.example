# Environment variables for Arena → TV Sync
# Copy this file to .env and fill in your values

# Required: Samsung Frame TV IP address
SMARTTHING_TV_IP_ADDRESS="10.100.0.30"

# Required: Are.na API token (get from https://dev.are.na/oauth/applications)
ARENA_TOKEN="your-arena-api-token-here"

# Optional: Are.na channel configuration
# Storage channel for mapping data (will be created as private if it doesn't exist)
ARENA_CHANNEL_SLUG="framer"
# Source channel for image blocks (required - can be overridden by ARENA_SOURCE_CHANNEL_SLUG block in storage channel)
# If not set via environment variable, create a text block titled "ARENA_SOURCE_CHANNEL_SLUG" in storage channel
# Note: The sync fetches up to 100 images per page. Keep your source channel under 100 images for full sync.
ARENA_SOURCE_CHANNEL_SLUG="your-source-channel-slug"

# Optional: Sync configuration
# Sync interval in seconds (for continuous mode)
SYNC_INTERVAL="300"
# Run once and exit (true/false/1/0)
# Note: Docker container defaults to SYNC_ONCE=true
SYNC_ONCE="false"
# Initialization mode - create Are.na channels and blocks (true/false/1/0)
INIT_MODE="false"

